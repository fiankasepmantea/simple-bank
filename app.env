ENVIRONMENT=development
# DB_SOURCE=postgresql://postgres:root@postgres:5432/simple_bank?sslmode=disable
DB_SOURCE=postgresql://postgres:root@simple-bank-postgres:5432/simple_bank?sslmode=disable
MIGRATION_URL=file:///app/db/migration
HTTP_SERVER_ADDRESS=0.0.0.0:8080
GRPC_SERVER_ADDRESS=0.0.0.0:9090
TOKEN_SYMMETRIC_KEY=12345678901234567890123456789012
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
REDIS_ADDRESS=0.0.0.0:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
KAFKA_BROKERS=simple-bank-kafka:9092
KAFKA_TOPIC=transaction-events